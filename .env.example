DATABASE_URL=postgresql://user:password@localhost:5432/task_manager
SECRET_KEY=change-me
SESSION_KEY=change-me
PRIVATE_KEY_PASSWORD=change-me
PRIVATE_KEY_PATH=keys/private.pem
PUBLIC_KEY_PATH=keys/public.pem
DEBUG=true
ENABLE_TRACING=false
ENABLE_METRICS=false
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO (defaults совпадают с docker-compose)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=task-manager-media
S3_PRESIGNED_PUT_TTL_SEC=600
S3_PRESIGNED_GET_TTL_SEC=120
# SigV4 GET под nginx→MinIO (docker DNS). Клиентский PUT — через S3_ENDPOINT_URL.
S3_X_ACCEL_ENDPOINT_URL=http://minio:9000
S3_X_ACCEL_PREFIX=/internal-s3
# presigned = 307 на MinIO (default / pytest); x_accel = через nginx :8080
ATTACHMENT_DOWNLOAD_MODE=presigned
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PER_TASK=5
# TTL pending-строк в БД до cleanup worker (default 24h)
ATTACHMENT_PENDING_TTL=24:00:00
ATTACHMENT_CLEANUP_INTERVAL_SEC=3600
